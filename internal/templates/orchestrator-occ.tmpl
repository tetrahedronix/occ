#!/bin/sh
# Generated by occ {{.OccVersion}} from {{.ConfigFile}} (sha256:{{.ConfigHash}})
# DO NOT EDIT: regenerate with `occ generate`

WORKDIR="{{.WorkDir}}"

mkdir -p "$HOME/.{{.AgentName}}-home"

cd "$WORKDIR" || exit 1

CMD="$1"
[ -z "$CMD" ] && CMD={{.AgentName}}

{{- if .ScriptOptions.SSH }}
if [ -z "$SSH_AUTH_SOCK" ]; then
    echo "Warning: SSH_AUTH_SOCK is not set. Start ssh-agent and run ssh-add before continuing." >&2
fi
{{- end }}

{{.Runtime}} run --rm -it \
{{- if eq .Runtime "podman" }}
  --userns=keep-id \
  --network=slirp4netns \
{{- end }}
  -v "$HOME/.{{.AgentName}}-home":/home/{{.AgentName}}:Z \
  -e HOME=/home/{{.AgentName}} \
  -e GIT_CONFIG_GLOBAL=/tmp/.gitconfig \
  -v "$(pwd)":/workspace:Z \
  -v "$HOME/.gitconfig":/tmp/.gitconfig:ro,Z \
{{- if .ScriptOptions.SSH }}
  -v "$SSH_AUTH_SOCK":/ssh-agent:Z \
  -e SSH_AUTH_SOCK=/ssh-agent \
{{- end }}
{{- if .ScriptOptions.GitHub }}
  -e GH_TOKEN="$GH_TOKEN" \
{{- end }}
  {{.ImageName}} "$CMD"